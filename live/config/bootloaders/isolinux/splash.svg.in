<svg xmlns="http://www.w3.org/2000/svg" width="640" height="480" viewBox="0 0 640 480">
  <defs>
    <linearGradient id="background" x1="0" y1="0" x2="1" y2="1">
      <stop stop-color="#10224d"/>
      <stop offset="1" stop-color="#07152f"/>
    </linearGradient>
    <linearGradient id="jade" x1="0" y1="0" x2="0" y2="1">
      <stop stop-color="#6ce0c0"/>
      <stop offset="1" stop-color="#167d9e"/>
    </linearGradient>
    <radialGradient id="glow">
      <stop stop-color="#167d9e" stop-opacity=".45"/>
      <stop offset="1" stop-color="#10224d" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="640" height="480" fill="url(#background)"/>
  <circle cx="520" cy="220" r="190" fill="url(#glow)"/>
  <path d="M0 430 640 300v180H0Z" fill="#167d9e" opacity=".13"/>
  <g transform="translate(450 56) scale(.52)">
    <rect x="8" y="8" width="240" height="240" rx="52" fill="#10224d"/>
    <path d="m128 32 78 45v88l-78 45-78-45V77Z" fill="url(#jade)"/>
    <path d="M153 83v69c0 22-13 35-37 35-17 0-30-7-39-20l18-15c6 9 13 13 21 13 10 0 15-5 15-15V83Z" fill="#10224d"/>
  </g>
  <text x="520" y="230" fill="#ffffff" font-family="Noto Sans, sans-serif"
        font-size="27" font-weight="600" text-anchor="middle">JadevOS</text>
  <text x="520" y="255" fill="#9ac9d7" font-family="Noto Sans, sans-serif"
        font-size="12" letter-spacing="3" text-anchor="middle">COMPUTERS</text>
  <path d="M472 279h96" stroke="#6ce0c0" stroke-opacity=".7"/>
  <text x="520" y="303" fill="#c7d7e7" font-family="Noto Sans, sans-serif"
        font-size="11" text-anchor="middle">Start your system</text>
</svg>
