[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'ding@rastersoft.com', 'blur-my-shell@aunetx', 'user-theme@gnome-shell-extensions.gcampax.github.com']
favorite-apps=['firefox-esr.desktop', 'org.gnome.Nautilus.desktop']

[org/gnome/shell/extensions/user-theme]
name='MacTahoe-Dark-orange'

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='MacTahoe-Dark-orange'
icon-theme='MacTahoe-orange-dark'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/jadevos-default-wallpaper.jpg'
picture-uri-dark='file:///usr/share/backgrounds/jadevos-default-wallpaper.jpg'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/jadevos-default-wallpaper.jpg'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=false
autohide=true
intellihide=true
dash-max-icon-size=48
transparency-mode='FIXED'
background-opacity=0.18
apply-custom-theme=true
custom-theme-shrink=true

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
